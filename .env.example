# Copy to .env and fill in. Never commit .env.

# REQUIRED — long random string, e.g. from:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

# Your public hostname behind the Cloudflare Tunnel.
ALLOWED_HOSTS=learn.getshtdonehq.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://learn.getshtdonehq.com

# Keep off in production.
DEBUG=false

TIME_ZONE=Asia/Manila

# Optional: create the first admin automatically on first boot.
# Remove these after the first start.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Optional: SMTP for password-reset emails. If EMAIL_HOST is empty, reset
# emails are printed to the container log instead (docker logs gsd-lms).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=GSD HQ <no-reply@getshtdonehq.com>

# Optional tuning (Pi 4B defaults are fine).
GUNICORN_WORKERS=2
GUNICORN_THREADS=3
SUBMISSION_MAX_MB=20
